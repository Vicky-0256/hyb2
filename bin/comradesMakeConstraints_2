#!/bin/bash
# Score chimeric read arms with RNAcofold and rank their paired intervals.
set -eo pipefail
usage() { echo "usage: comradesMakeConstraints_2 -i reads.hyb -f reference.fasta -b start -e end [-n count] [-r mode]" >&2; exit 2; }
hyb= ref= start= end=
limit=75
while getopts "i:f:b:e:n:r:" opt; do
	case "$opt" in i) hyb=$OPTARG;; f) ref=$OPTARG;; b) start=$OPTARG;; e) end=$OPTARG;;
		n) limit=$OPTARG;; r) :;; *) usage;; esac
done
shift $((OPTIND-1))
[[ $# == 0 && "$hyb" == *.hyb && -n "$ref" && "$start" =~ ^[0-9]+$ &&
   "$end" =~ ^[0-9]+$ && "$limit" =~ ^[0-9]+$ ]] || usage
[[ $((10#$start)) -ge 1 && $((10#$end)) -ge $((10#$start)) ]] || usage

prefix=${hyb%.hyb}
ref_name=${ref##*/}
fragment=${ref%"$ref_name"}${ref_name%.*}_$start-$end.fasta
scores=$prefix.basepair_scores.txt
constraints=$prefix.$start-${end}_folding_constraints.txt
outputs=("$fragment" "$scores" "$constraints")
for output in "${outputs[@]}"; do
	[[ ! "$output" -ef "$ref" && ! "$output" -ef "$hyb" && ! -d "$output" ]] || { echo "Output conflicts with input: $output" >&2; exit 1; }
done
work=$(mktemp -d "${TMPDIR:-/tmp}/hyb2-constraints.XXXXXX")
cleanup() {
	local rc=$?
	rm -rf -- "$work"
	if [[ $rc != 0 ]]; then rm -f -- "${outputs[@]}"; fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
rm -f -- "${outputs[@]}"
for source in "$hyb" "$ref"; do [[ -f "$source" && -r "$source" ]] || { echo "Cannot read scoring input: $source" >&2; exit 1; }; done
[[ "$hyb" == /* ]] || hyb=$PWD/$hyb
ln -s -- "$hyb" "$work/reads.hyb"
fasta2tab.awk "$ref" | awk -F '\t' 'BEGIN{OFS="\t"} {
	name=$1; sub(/^[[:space:]]+/, "", name); split(name, fields, /[[:space:]]+/); seq=$2; gsub(/[[:space:]]/, "", seq)
	if (fields[1]=="" || !length(seq) || seen["@" fields[1]]++) {print "Invalid or duplicate reference record: " $1 > "/dev/stderr"; exit 1}
	print fields[1],seq
}' > "$work/ref.tab"
awk -F '\t' -v b="$start" -v e="$end" 'e>length($2) {
	print "Requested window exceeds " $1 " (" length($2) " bases)" > "/dev/stderr"; exit 1
} {print ">" $1 "\n" substr($2,b,e-b+1)}' "$work/ref.tab" > "$work/fragment"
(
	cd "$work"
	: > reads.bit_1.fasta
	: > reads.bit_2.fasta
	hyb2fasta_bits_allRNAs.awk ref.tab reads.hyb
	: > scores
	: > constraints
	# Empty selections and valid structures with zero inter-arm pairs produce empty scores.
	if [[ -s reads.bit_1.fasta || -s reads.bit_2.fasta ]]; then
		awk 'FNR%2 {n=split($0,a,"_"); expected=a[n]-a[n-1]+1; next}
		     expected<1 || length($0)!=expected {print "Read arm outside its reference" > "/dev/stderr"; exit 1}' reads.bit_1.fasta reads.bit_2.fasta
		paste -d '&' reads.bit_1.fasta reads.bit_2.fasta > paired.fa
		sed 's/&>/-/g;s/&//g' paired.fa > expected.fa
		RNAcofold --noconv --noPS < paired.fa | sed 's/&>/-/g;s/&//g' > cofold.dbn
		b2ct < cofold.dbn | sed 's/ENERGY =/dG =/g' > cofold.ct
		LC_ALL=C awk -v vienna=cofold.dbn -f "$(command -v comrades_ct.awk)" expected.fa cofold.ct
		ct2bps_2.awk -v arms=paired.fa cofold.ct | histogram.pl | LC_ALL=C sort -k3,3nr -k1,1n -k2,2n > scores
		awk -v b="$start" -v e="$end" 'printed<=1000 && $1>=b && $1<=e && $2>=b && $2<=e {print; printed++}' scores |
			bp2hyb.sh | hyb2constraints.pl |
			awk -v b="$start" -v n="$limit" 'BEGIN{OFS="\t"} NR<=n {print $1,$2-b+1,$3-b+1,$4}' > constraints
	fi
)
mv -- "$work/fragment" "$fragment"
mv -- "$work/scores" "$scores"
mv -- "$work/constraints" "$constraints"
