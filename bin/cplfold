#!/usr/bin/env python3
"""Run the vendored CPLfold command in an isolated Python process."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "third_party/cplfold"))
from cplfold import InputError as _InputError
from cplfold.sequence import clean as _clean, read_sequence_file as _read_sequence_file


DEFAULT_MAX_SEQUENCE_LENGTH = 1000
# Hyb2's one-strand reads scaling when --alpha is omitted; the package default is 0.
SINGLE_STRAND_ALPHA = "0.5"


def _sequence_arguments(arguments: list[str], cofold: bool = False) -> tuple[str | None, list[str]]:
    parser = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    parser.add_argument("-s", "--sequence")
    parser.add_argument("--sequence-file", type=Path)
    parser.add_argument("--sequence-two")
    parser.add_argument("--cutpoint")
    parser.add_argument("--alpha")
    parser.add_argument("-n2", "--max-phase2")
    parser.add_argument("--cofold", action="store_true")
    parsed, _ = parser.parse_known_args(arguments)
    if parsed.sequence is not None and parsed.sequence_file is not None:
        raise SystemExit("Use either --sequence or --sequence-file, not both")
    arguments = list(arguments)
    if parsed.sequence_file is None:
        sequence = parsed.sequence
        if sequence is not None and parsed.sequence_two is not None:
            sequence += "&" + parsed.sequence_two
        return sequence, _single_strand_defaults(arguments, parsed, sequence, cofold)

    try:
        sequence = _read_sequence_file(parsed.sequence_file, cofold=cofold or parsed.cofold)
    except _InputError as error:  # invalid contents: the message alone, status 2
        print(error, file=sys.stderr)
        raise SystemExit(2) from error
    except OSError as error:
        raise SystemExit(str(error)) from error
    forwarded = []
    skip_next = False
    for argument in arguments:
        if skip_next:
            skip_next = False
            continue
        if argument == "--sequence-file":
            skip_next = True
            continue
        if argument.startswith("--sequence-file="):
            continue
        forwarded.append(argument)
    forwarded.extend(["--sequence", sequence])
    guard_sequence = sequence + "&" + parsed.sequence_two if parsed.sequence_two is not None else sequence
    return guard_sequence, _single_strand_defaults(forwarded, parsed, guard_sequence, cofold)


def _positive_integer(text: str | None) -> bool:
    try:
        return text is not None and int(text) >= 1
    except ValueError:
        return False


def _single_strand_defaults(arguments: list[str], parsed: argparse.Namespace, sequence: str | None,
                            cofold: bool) -> list[str]:
    """Keep Hyb2's one-strand commands as they were before cplfold 1.0.

    The package defaults alpha to 0; Hyb2 keeps 0.5 for one strand by passing it.
    The package rejects --max-phase2 for one strand, where it never had an
    effect; a valid value is dropped, an invalid one is still forwarded and rejected.
    """
    two_strands = cofold or parsed.cofold or parsed.cutpoint is not None or (sequence is not None and "&" in sequence)
    if two_strands:
        return arguments
    if _positive_integer(parsed.max_phase2):
        kept, skip_next = [], False
        for argument in arguments:
            if skip_next:
                skip_next = False
            elif argument in ("-n2", "--max-phase2"):
                skip_next = True
            elif not argument.startswith(("-n2=", "--max-phase2=")):
                kept.append(argument)
        arguments = kept
    if parsed.alpha is None:
        arguments = [*arguments, "--alpha", SINGLE_STRAND_ALPHA]
    return arguments


def _maximum_sequence_length() -> int:
    raw_value = os.environ.get(
        "HYB2_CPLFOLD_MAX_NT", str(DEFAULT_MAX_SEQUENCE_LENGTH)
    )
    try:
        value = int(raw_value)
    except ValueError as error:
        raise SystemExit("HYB2_CPLFOLD_MAX_NT must be a positive integer") from error
    if value < 1:
        raise SystemExit("HYB2_CPLFOLD_MAX_NT must be a positive integer")
    return value


def _default_numba_cache_directory() -> Path:
    configured_root = os.environ.get("XDG_CACHE_HOME")
    cache_root = (
        Path(configured_root).expanduser()
        if configured_root
        else Path.home() / ".cache"
    )
    cache_directory = cache_root / "hyb2" / "cplfold-numba"
    if cache_directory.is_symlink():
        raise SystemExit(f"Refusing symlinked Numba cache: {cache_directory}")
    cache_directory.mkdir(mode=0o700, parents=True, exist_ok=True)

    status = cache_directory.stat()
    if hasattr(os, "getuid") and status.st_uid != os.getuid():
        raise SystemExit(f"Numba cache is not owned by the current user: {cache_directory}")
    cache_directory.chmod(0o700)
    return cache_directory


def main(cofold_entry: bool = False) -> None:
    repository = Path(__file__).resolve().parents[1]
    import_root = repository / "third_party" / "cplfold"
    entrypoint = import_root / "cplfold" / "cli.py"
    if not entrypoint.is_file():
        raise SystemExit(f"Vendored CPLfold entry point is missing: {entrypoint}")

    sequence, forwarded_arguments = _sequence_arguments(sys.argv[1:], cofold=cofold_entry)
    maximum = _maximum_sequence_length()
    length = len(_clean(sequence).replace("&", "")) if sequence is not None else 0
    if length > maximum:
        raise SystemExit(
            f"CPLfold input is {length} nt; the Hyb2 safety limit is "
            f"{maximum} nt. Set HYB2_CPLFOLD_MAX_NT explicitly to override it."
        )

    if "NUMBA_CACHE_DIR" not in os.environ:
        os.environ["NUMBA_CACHE_DIR"] = str(_default_numba_cache_directory())

    # Equivalent to ``python -m cplfold.cli``, but with the package's import root
    # instead of the working directory as sys.path[0], as a script path would give.
    bootstrap = (
        "import sys; sys.path[0] = sys.argv.pop(1); from cplfold.cli import "
        + ("cofold_main as main" if cofold_entry else "main") + "; sys.exit(main())"
    )
    arguments = [sys.executable, "-c", bootstrap, str(import_root), *forwarded_arguments]
    if os.name == "nt":  # Windows exec joins the arguments without quoting them
        arguments = [subprocess.list2cmdline([argument]) for argument in arguments]
    os.execv(sys.executable, arguments)


if __name__ == "__main__":
    main()
