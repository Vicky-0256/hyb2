#!/usr/bin/env python3
"""Run the vendored CPLfold command in an isolated Python process."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "third_party/cplfold"))
from Utils.cli_input import read_sequence_file as _read_sequence_file


DEFAULT_MAX_SEQUENCE_LENGTH = 1000


def _sequence_arguments(arguments: list[str], cofold: bool = False) -> tuple[str | None, list[str]]:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-s", "--sequence")
    parser.add_argument("--sequence-file", type=Path)
    parser.add_argument("--sequence-two")
    parser.add_argument("--cofold", action="store_true")
    parsed, _ = parser.parse_known_args(arguments)
    if parsed.sequence is not None and parsed.sequence_file is not None:
        raise SystemExit("Use either --sequence or --sequence-file, not both")
    if parsed.sequence_file is None:
        sequence = parsed.sequence
        if sequence is not None and parsed.sequence_two is not None:
            sequence += "&" + parsed.sequence_two
        return sequence, list(arguments)

    sequence = _read_sequence_file(parsed.sequence_file, cofold=cofold or parsed.cofold)
    forwarded = []
    skip_next = False
    for argument in arguments:
        if skip_next:
            skip_next = False
            continue
        if argument == "--sequence-file":
            skip_next = True
            continue
        if argument.startswith("--sequence-file="):
            continue
        forwarded.append(argument)
    forwarded.extend(["--sequence", sequence])
    guard_sequence = sequence + "&" + parsed.sequence_two if parsed.sequence_two is not None else sequence
    return guard_sequence, forwarded


def _maximum_sequence_length() -> int:
    raw_value = os.environ.get(
        "HYB2_CPLFOLD_MAX_NT", str(DEFAULT_MAX_SEQUENCE_LENGTH)
    )
    try:
        value = int(raw_value)
    except ValueError as error:
        raise SystemExit("HYB2_CPLFOLD_MAX_NT must be a positive integer") from error
    if value < 1:
        raise SystemExit("HYB2_CPLFOLD_MAX_NT must be a positive integer")
    return value


def _default_numba_cache_directory() -> Path:
    configured_root = os.environ.get("XDG_CACHE_HOME")
    cache_root = (
        Path(configured_root).expanduser()
        if configured_root
        else Path.home() / ".cache"
    )
    cache_directory = cache_root / "hyb2" / "cplfold-numba"
    if cache_directory.is_symlink():
        raise SystemExit(f"Refusing symlinked Numba cache: {cache_directory}")
    cache_directory.mkdir(mode=0o700, parents=True, exist_ok=True)

    status = cache_directory.stat()
    if hasattr(os, "getuid") and status.st_uid != os.getuid():
        raise SystemExit(f"Numba cache is not owned by the current user: {cache_directory}")
    cache_directory.chmod(0o700)
    return cache_directory


def main(cofold_entry: bool = False) -> None:
    repository = Path(__file__).resolve().parents[1]
    entrypoint = repository / "third_party" / "cplfold" / ("CPLcofold.py" if cofold_entry else "CPLfold.py")
    if not entrypoint.is_file():
        raise SystemExit(f"Vendored CPLfold entry point is missing: {entrypoint}")

    sequence, forwarded_arguments = _sequence_arguments(sys.argv[1:], cofold=cofold_entry)
    maximum = _maximum_sequence_length()
    length = len("".join(sequence.split()).replace("&", "")) if sequence is not None else 0
    if length > maximum:
        raise SystemExit(
            f"CPLfold input is {length} nt; the Hyb2 safety limit is "
            f"{maximum} nt. Set HYB2_CPLFOLD_MAX_NT explicitly to override it."
        )

    if "NUMBA_CACHE_DIR" not in os.environ:
        os.environ["NUMBA_CACHE_DIR"] = str(_default_numba_cache_directory())

    os.execv(
        sys.executable,
        [sys.executable, str(entrypoint), *forwarded_arguments],
    )


if __name__ == "__main__":
    main()
