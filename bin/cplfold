#!/usr/bin/env python3
"""Run the vendored CPLfold command in an isolated Python process."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import sys


DEFAULT_MAX_SEQUENCE_LENGTH = 1000


def _sequence_from_args(arguments: list[str]) -> str | None:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-s", "--sequence")
    parsed, _ = parser.parse_known_args(arguments)
    return parsed.sequence


def _maximum_sequence_length() -> int:
    raw_value = os.environ.get(
        "HYB2_CPLFOLD_MAX_NT", str(DEFAULT_MAX_SEQUENCE_LENGTH)
    )
    try:
        value = int(raw_value)
    except ValueError as error:
        raise SystemExit("HYB2_CPLFOLD_MAX_NT must be a positive integer") from error
    if value < 1:
        raise SystemExit("HYB2_CPLFOLD_MAX_NT must be a positive integer")
    return value


def _default_numba_cache_directory() -> Path:
    configured_root = os.environ.get("XDG_CACHE_HOME")
    cache_root = (
        Path(configured_root).expanduser()
        if configured_root
        else Path.home() / ".cache"
    )
    cache_directory = cache_root / "hyb2" / "cplfold-numba"
    if cache_directory.is_symlink():
        raise SystemExit(f"Refusing symlinked Numba cache: {cache_directory}")
    cache_directory.mkdir(mode=0o700, parents=True, exist_ok=True)

    status = cache_directory.stat()
    if hasattr(os, "getuid") and status.st_uid != os.getuid():
        raise SystemExit(f"Numba cache is not owned by the current user: {cache_directory}")
    cache_directory.chmod(0o700)
    return cache_directory


def main() -> None:
    repository = Path(__file__).resolve().parents[1]
    entrypoint = repository / "third_party" / "cplfold" / "CPLfold.py"
    if not entrypoint.is_file():
        raise SystemExit(f"Vendored CPLfold entry point is missing: {entrypoint}")

    sequence = _sequence_from_args(sys.argv[1:])
    maximum = _maximum_sequence_length()
    if sequence is not None and len(sequence.strip()) > maximum:
        raise SystemExit(
            f"CPLfold input is {len(sequence.strip())} nt; the Hyb2 safety limit is "
            f"{maximum} nt. Set HYB2_CPLFOLD_MAX_NT explicitly to override it."
        )

    if "NUMBA_CACHE_DIR" not in os.environ:
        os.environ["NUMBA_CACHE_DIR"] = str(_default_numba_cache_directory())

    os.execv(
        sys.executable,
        [sys.executable, str(entrypoint), *sys.argv[1:]],
    )


if __name__ == "__main__":
    main()
