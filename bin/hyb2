#!/bin/bash
set -e
#hyb2
#takes aligned proximity ligation reads from different mapping tools in the SAM format to be processed in the hyb pipeline
#generates a list of chimeric interactions with their coordinates, sequence, and folding energy
#plots contact density map of selected genes
#generates intra-/intermolecular RNA structure of any selected regions

#hyb2 split into 3 steps
#processing SAM file -i input_SAM_file -1 fasta_file_used_for_mapping -2 -o Output_ID -v BLAST_THRESHOLD -m MAX_OVERLAP -h MAX_HITS_PER_SEQUENCE 
#heatmap 2nd_fasta_file_if_different_from_1st -a GENE_ID_of_interest -b 2nd_GENE_ID_of interest_if_different -q Upperlimit%_for_heatmap_chimeric_count 
#RNA folding -x START_COORD_of_1st_strand/gene -y START_COORD_of_2nd_strand/gene -l length_of_fragments -j directory_of_VARNAcmd.jar

#FOLD=1 for ViennaRNA, 0 for UNAFold, 2 for mfold 3.6 (structures; dG as FOLD=1)
hval=0.1
gmax=4
hmax=10
LIMIT=0.95
ENERGY=0
FOLD=1
VARNA=$(VARNAcmd.sh 2>/dev/null) || VARNA=

# Help message function
print_help() {
    echo "No Options Specified!"
    echo "Usage:"
    echo "To run hyb2, make sure you've activated the conda environment:"
    echo "conda activate <hyb2/hyb2_macOS/hyb2_macOS-arm>"
    echo "hyb2 -i <Input.Fastq/SAM> -d <Fasta_File> -o <Output_ID> -a <GENE_ID_1> -x <START_COORD_1> -y <START_COORD_2> -l <Length_of_Fragments>"
    echo "Options:"
    echo "  -i   Input .fastq/.fq (optionally .gz), .fasta/.fa, .sam, or completed .hyb file"
    echo "  -d, -1   First reference FASTA used for mapping and folding"
    echo "  -2   Optional second reference FASTA (defaults to the first)"
    echo "  -o   Output ID"
    echo "  -v   BLAST threshold (default=0.1)"
    echo "  -m   Maximum overlap (default=4)"
    echo "  -h   Maximum hits per sequence (default=10)"
    echo "  -a   Gene ID of interest"
    echo "  -b   Second gene ID of interest (if different)"
    echo "  -q   Upper limit for heatmap chimeric count (default=0.95)"
    echo "  -x   Start coordinate of 1st strand/gene for zoomed-in contact and folding"
    echo "  -y   Start coordinate of 2nd strand/gene for zoomed-in contact and folding"
    echo "  -l   Length of fragments for zoomed-in contact and folding"
    echo "  -j   Directory of VARNAcmd.jar (default set when installing hyb2)"
    echo "  -e   Calculate Folding Energy: 1 to calculate, 0 to skip and save on runtime (default=0)"
    echo "  -r   Folding Algorithm: 1 for ViennaRNA, 0 for UNAFold (if installed separately), 2 for mfold 3.6 (conda install -c bioconda mfold) (default=1)"
    echo " "
    echo "To only plot contact density map after generating hyb output:"
    echo "hyb2 -i <Output.hyb> -a <GENE_ID_1>"
    echo "Or:"
    echo "hyb2_coverage -i <Output.hyb> -a <GENE_ID_1> -w <X_COORD_1> -x <X_COORD_2> -y <Y_COORD_1> -z <Y_COORD_2>"
    echo "  -i   Output.hyb from running hyb2"
    echo "  -a   Gene ID of interest"
    echo "  -b   Second gene ID of interest (if different)"
    echo "  -q   Upper limit for heatmap chimeric count (default=0.95)"
    echo "  -w   Start coordinate of x1 for zoomed-in contact"
    echo "  -x   Start coordinate of x2 for zoomed-in contact"
    echo "  -y   Start coordinate of y1 for zoomed-in contact (or 2nd gene coord_1 if -b)"
    echo "  -z   Start coordinate of y2 for zoomed-in contact (or 2nd gene coord_2 if -b)"
    echo " "
    echo "To only fold RNA structures:"
    echo "hyb2_fold -i <Output.hyb> -d <Fasta_File> -a <GENE_ID_1> -x <START_COORD_1> -y <START_COORD_2> -l <Length_of_Fragments>"
    echo "  -i   Output.hyb from running hyb2"
    echo "  -d   Fasta file used for mapping"
    echo "  -a   Gene ID of interest"
    echo "  -b   Second gene ID of interest (if different)"
    echo "  -x   Start coordinate of 1st strand/gene for folding"
    echo "  -y   Start coordinate of 2nd strand/gene for folding"
    echo "  -j   Directory of VARNAcmd.jar (default set when installing hyb2)"
    echo "  -r   Folding Algorithm: 1 for ViennaRNA, 0 for UNAFold (if installed separately), 2 for mfold 3.6 (conda install -c bioconda mfold) (default=1)"
    echo "  -0   Interactive Mode for VARNA Pop-up: 0 to disable, 1 to activate (default=0)"
    echo " "
    echo "To start GUI:"
    echo "hyb2_app -i <Output.hyb> -d <Fasta_File> -a <GENE_ID_1> "
    echo "  -i   Output.hyb from running hyb2"
    echo "  -d   Fasta file used for mapping"
    echo "  -a   Gene ID of interest"
    echo "  -b   Second gene ID of interest (if different)"
    echo "  -j   Directory of VARNAcmd.jar (default set when installing hyb2)"
    echo " "
    echo "To compare between datasets after generating hyb2 files:"
    echo "hyb2_compare -i <Input.table> -o <Outpud_ID> -a <GENE_ID> -d <Fasta_File>"
    echo "Run hyb2_compare without options for more help details regarding hyb2_compare"
    echo " "
    echo "Any other queries, email me at laujianyou@live.com"
    exit 0
}

# parsing command line options
IN_FILE= DB_1= DB_2= OUT=
while getopts "i:d:1:2:o:v:m:h:a:b:q:x:y:l:j:r:e:" OPTION
do
     case $OPTION in
         i) IN_FILE=$OPTARG ;;
         d|1) DB_1=$OPTARG ;;
         2) DB_2=$OPTARG ;;
         o) OUT=$OPTARG ;;
         v) hval=$OPTARG ;;
         m) gmax=$OPTARG;;
         h) hmax=$OPTARG;;
         a) GENE_1=$OPTARG ;;
         b) GENE_2=$OPTARG ;;
         q) LIMIT=$OPTARG ;;
         x) X_COORD=$OPTARG ;;
         y) Y_COORD=$OPTARG ;;
         l) LEN=$OPTARG ;;
	 j) VARNA=$OPTARG ;;
	 e) ENERGY=$OPTARG ;;
	 r) FOLD=$OPTARG ;;
         *) echo "Invalid hyb2 option or missing value." >&2; exit 2 ;;
     esac
done

if (( $# == 0 )); then
     print_help
fi
shift $((OPTIND - 1))
if (( $# )); then echo "Unexpected hyb2 argument: $1" >&2; exit 2; fi
if [[ -z "$IN_FILE" ]]; then echo "hyb2 requires an input file (-i)." >&2; exit 2; fi
for coordinate in "$X_COORD" "$Y_COORD" "$LEN"; do
	if [[ -n "$coordinate" && ( ! "$coordinate" =~ ^[0-9]+$ || "$coordinate" =~ ^0+$ ) ]]; then
		echo "Coordinates and fragment length must be positive integers." >&2
		exit 2
	fi
done
if [[ -n "$X_COORD" ]]; then X_COORD=$((10#$X_COORD)); fi
if [[ -n "$Y_COORD" ]]; then Y_COORD=$((10#$Y_COORD)); fi
if [[ -n "$LEN" ]]; then LEN=$((10#$LEN)); fi
# Thresholds as hyb2pipe reads them (scientific notation such as 1e-5 is fine).
number='^[+-]?([0-9]+\.?[0-9]*|\.[0-9]+)([eE][+-]?[0-9]+)?$'
for option in "v=$hval" "m=$gmax"; do
	if [[ ! "${option#*=}" =~ $number ]]; then
		echo "hyb2: -${option%%=*} must be a number (for example 0.1 or 1e-5): ${option#*=}" >&2
		exit 2
	fi
done
if [[ ! "$hmax" =~ ^[0-9]+$ ]]; then echo "hyb2: -h must be a whole number: $hmax" >&2; exit 2; fi

#UNAFold (-r 0) and mfold (-r 2) folding need a program that applies forced
#pairs: stop now rather than after mapping (unafold_check, mfold_check)
case "$FOLD" in
	1) ;;
	0) if [ ! -z $X_COORD ] && [ ! -z $LEN ]; then unafold_check || exit 1; fi ;;
	2) if [ ! -z $X_COORD ] && [ ! -z $LEN ]; then mfold_check || exit 1; fi ;;
	*) echo "-r must be 1 (ViennaRNA), 0 (UNAFold) or 2 (mfold)" 1>&2; exit 1 ;;
esac
#the .hyb dG column (sam2hyb): mfold has no duplex folding, so mode 2 uses
#RNAcofold, as mode 1
ENERGY_FOLD=$FOLD
if [ "$FOLD" == "2" ]
then
	ENERGY_FOLD=1
fi

#Step1 --------------------------------------------------------------------------------------------------------------------------------------------------
#Process SAM files to Hyb format

original_ref_1=$DB_1
original_ref_2=$DB_2
for input in "$IN_FILE" "$original_ref_1" "$original_ref_2"; do
    [[ -z "$input" || ( -f "$input" && -r "$input" ) ]] || { echo "Cannot read input: $input" >&2; exit 1; }
done
mapper=
case "$IN_FILE" in
    *.fastq.gz|*.fq.gz) mapper=bowtie2_fastq.gz2sam ;;
    *.fastq|*.fq) mapper=bowtie2_fastq2sam ;;
    *.fasta|*.fa) mapper=bowtie2_fasta2sam ;;
    *.sam|*.hyb) ;;
    *) echo "Unsupported hyb2 input format: $IN_FILE" >&2; exit 2 ;;
esac
if [[ "$IN_FILE" == *.hyb ]]; then
    OUT=${IN_FILE%.hyb}  # downstream tools use the explicit HYB, even if -o was given
    echo "Hyb Format As Input Detected"
elif [[ -z "${OUT##*/}" || "${OUT##*/}" == . || "${OUT##*/}" == .. ]]; then
    echo "hyb2 requires an output prefix with a filename (-o)." >&2; exit 2
elif [[ "$OUT.hyb" -ef "$IN_FILE" || "$OUT.hyb" -ef "$original_ref_1" || "$OUT.hyb" -ef "$original_ref_2" ]]; then
    echo "HYB output conflicts with an input: $OUT.hyb" >&2; exit 1
fi

bin_dir=$(cd -- "$(dirname -- "$0")" && pwd)
work=
temporary=()
outputs=()
protected=(--protect="$IN_FILE" --protect="$original_ref_1" --protect="$original_ref_2")
cleanup() {
    local directory
    if [[ -n "$work" && -e "$work/.publishing" ]]; then
        printf 'hyb2: interrupted publication; recover staged files and originals in %s\n' "${temporary[@]}" >&2
    else
        for directory in "${temporary[@]}"; do rm -rf -- "$directory"; done
    fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
# <out>.hyb.inputs records what step 1 read (path, size and mtime of the input
# and of reference 1, the only reference step 1 uses), its options, and the
# size and mtime of the .hyb and _homodimers.hyb it published with them. A .hyb
# whose record differs (other inputs or options, or a .hyb rewritten since) is
# recomputed. Bump the format line when these rules change. A .hyb without a
# record (an explicit -i .hyb, or one from hyb2pipe, which removes the record,
# or from an older hyb2) is kept as it is.
record=
if [[ "$IN_FILE" != *.hyb ]]; then
    record=$(python3 -c 'import os, sys
for label, path in zip(("input", "reference_1"), sys.argv[1:]):
    info = os.stat(path) if path else None
    print(label, os.path.realpath(path) if path else "-", info.st_size if info else "-",
          info.st_mtime_ns if info else "-", sep="\t")' "$IN_FILE" "$original_ref_1")
    record=$(printf 'hyb2 step 1 record format 3\n%s\noptions\t-v %s -m %s -h %s -e %s' "$record" "$hval" "$gmax" "$hmax" "$ENERGY")
fi
published_outputs() {  # the files <prefix>.hyb.inputs vouches for
    python3 -c 'import os, sys
for label, path in zip(("hyb", "homodimers"), sys.argv[1:]):
    info = os.stat(path) if os.path.isfile(path) else None
    print(label, info.st_size if info else "-", info.st_mtime_ns if info else "-", sep="\t")' "$1.hyb" "${1}_homodimers.hyb"
}
if [[ -f "$OUT.hyb" && ( -z "$record" || ! -f "$OUT.hyb.inputs" ||
      "$(cat -- "$OUT.hyb.inputs")" == "$record"$'\n'"$(published_outputs "$OUT")" ) ]]; then
    convert=0
    protected+=(--protect="$OUT.hyb")
    echo "Hyb File Exist. Next Step."
    if [[ -n "$record" && ! -f "$OUT.hyb.inputs" ]]; then
        echo "hyb2: keeping $OUT.hyb, which has no record of its inputs ($OUT.hyb.inputs); delete it to recompute." >&2
    fi
else
    if [[ -f "$OUT.hyb" ]]; then echo "$OUT.hyb was made from other inputs or options, or changed since; recomputing."; fi
    convert=1
    if [[ -n "$mapper" && -z "$DB_1" ]]; then echo "Mapping requires a reference (-d)." >&2; exit 2; fi
    work=$(mktemp -d "$(dirname -- "$OUT")/.hyb2.XXXXXXXX")
    temporary+=("$work")
fi

# Stage each reference on its own filesystem. Mapping/energy read the new
# contents privately; folding and plotting later receive the published names.
ref_stage=
prepare_reference() {
    local source=$1 parent status
    shift
    ref_target=$source
    ref_input=$source
    [[ -n "$source" ]] || return 0
    # hyb2pipe's rule: rewrite the IDs when any header contains '|'
    if PYTHONPATH="$bin_dir/../pipeline${PYTHONPATH:+:$PYTHONPATH}" python3 -B -m hyb2pipe.reference_cli check "$source"; then
        parent=$(dirname -- "$source")
        if [[ -z "$ref_stage" || ! "$parent" -ef "$ref_stage/.." ]]; then
            ref_stage=$(mktemp -d "$parent/.hyb2-ref.XXXXXXXX")
            temporary+=("$ref_stage")
            [[ -n "$work" ]] || work=$ref_stage
        fi
        ref_target=$(fasta_hyb2_formatting -i "$source" -S "$ref_stage" -P \
            -p "$IN_FILE" -p "$original_ref_1" -p "$original_ref_2" -p "$OUT.hyb" "$@")
        ref_input=$ref_stage/${ref_target##*/}
        outputs+=("$ref_input" "$ref_target")
    else
        status=$?
        [[ $status == 1 ]] || return "$status"
    fi
}
prepare_reference "$original_ref_1"
DB_1=$ref_target
conversion_ref=$ref_input
if [[ -z "$original_ref_2" || "$original_ref_2" -ef "$original_ref_1" ]]; then
    DB_2=$DB_1
else
    prepare_reference "$original_ref_2" -p "$DB_1"
    DB_2=$ref_target
fi

if (( convert )); then
    stage=$work/converted
    if [[ -n "$mapper" ]]; then
        status=0
        "$mapper" -i "$IN_FILE" -d "$conversion_ref" -o "$stage" || status=$?
        # Diagnostics describe the attempted run, including mapper failures.
        # Never let the log replace an explicit input or another result.
        if [[ -f "$stage.blast.err" ]]; then
            python3 "$bin_dir/sam2hyb_publish.py" --work="$work" "${protected[@]}" --protect="$OUT.sam" \
                --protect="${OUT}_homodimers.hyb" --protect="${OUT}_hybrids.hyb_stats.txt" \
                --protect="$DB_1" --protect="$DB_2" -- "$stage.blast.err" "$OUT.blast.err"
        fi
        (( status == 0 )) || { echo "Mapping failed." >&2; exit "$status"; }
        [[ -f "$stage.sam" && -s "$stage.sam" ]] || { echo "Mapping did not produce a nonempty SAM file." >&2; exit 1; }
        echo "SAM file generated"
    else
        sam_filt "$IN_FILE" > "$stage.sam"
    fi
    # For a SAM input it is legitimate for the traditional filtered .sam
    # output to name the input (or an alias). Keep that original in place.
    if [[ -n "$mapper" || ( ! "$OUT.sam" -ef "$IN_FILE" && ! "$OUT.sam" -ef "$original_ref_1" && ! "$OUT.sam" -ef "$original_ref_2" ) ]]; then
        outputs+=("$stage.sam" "$OUT.sam")
    fi
    sam2hyb -i "$stage.sam" -d "$conversion_ref" -o "$stage" -v "$hval" -g "$gmax" -h "$hmax" -e "$ENERGY" -r "$ENERGY_FOLD" || {
        echo "SAM conversion failed." >&2; exit 1
    }
    # Publishing renames the staged files, which keeps their size and mtime.
    { printf '%s\n' "$record"; published_outputs "$stage"; } > "$stage.hyb.inputs"
    # The publisher requires every staged file and installs the completion marker last.
    for suffix in _homodimers.hyb _hybrids.hyb_stats.txt .hyb.inputs .hyb; do
        outputs+=("$stage$suffix" "$OUT$suffix")
    done
fi
if (( ${#outputs[@]} )); then
    python3 "$bin_dir/sam2hyb_publish.py" --work="$work" "${protected[@]}" -- "${outputs[@]}"
fi
if (( convert )); then echo "Hyb File Generated."; fi
cleanup
trap - EXIT HUP INT TERM

#Step2 --------------------------------------------------------------------------------------------------------------------------------------------------
#Plot contact density map of selected genes
# Plot helpers do not otherwise know about the original reads or about a
# reference whose formatted copy was used for this run.
plot_protect=()
for path in "$IN_FILE" "$original_ref_1" "$original_ref_2" "$DB_1" "$DB_2" "$OUT.sam" "$OUT.blast.err" "${OUT}_homodimers.hyb" "${OUT}_hybrids.hyb_stats.txt"; do
    if [[ -n "$path" ]]; then plot_protect+=(-p "$path"); fi
done
coverage() { hyb2_coverage -i "$OUT.hyb" -q "$LIMIT" "$@" "${plot_protect[@]}"; }
if [[ -n "$GENE_1" ]]
then
	coverage -a "$GENE_1"
fi

if [[ -n "$GENE_2" ]]
then
	coverage -a "$GENE_1" -b "$GENE_2"
else
	echo "To plot contact density map of second gene, add to command: -b <GENE_ID_2>." 1>&2
fi

if [[ -z "$GENE_2" && -z "$Y_COORD" && -n "$LEN" ]]
then
	X_END=$(($X_COORD+$LEN-1))
	coverage -a "$GENE_1" -w "$X_COORD" -x "$X_END" -y "$X_COORD" -z "$X_END"
elif [[ -z "$GENE_2" && -n "$Y_COORD" && -n "$LEN" ]]
then
	X_END=$(($X_COORD+$LEN-1))
	Y_END=$(($Y_COORD+$LEN-1))
	coverage -a "$GENE_1" -w "$X_COORD" -x "$X_END" -y "$Y_COORD" -z "$Y_END"
elif [[ -n "$GENE_2" && -n "$Y_COORD" && -n "$LEN" ]]
then
	X_END=$(($X_COORD+$LEN-1))
	Y_END=$(($Y_COORD+$LEN-1))
	coverage -a "$GENE_1" -b "$GENE_2" -w "$X_COORD" -x "$X_END" -y "$Y_COORD" -z "$Y_END"
else
	echo "To plot zoomed-in contact density map, add to command: -x <X_Coord> -y <Y_Coord> -l <Length>." 1>&2
fi

#Plot viewpoint graphs of selected genes
if [[ -n "$GENE_1" && -n "$DB_1" ]]; then
	viewpoint_args=(-i "$OUT.hyb" -a "$GENE_1" -1 "$DB_1")
	if [[ -n "$GENE_2" ]]; then viewpoint_args+=(-b "$GENE_2" -2 "$DB_2"); fi
	plot_viewpoint "${viewpoint_args[@]}" "${plot_protect[@]}"
fi
#Step3 --------------------------------------------------------------------------------------------------------------------------------------------------
#Generate RNA Secondary Structure of selected strands
if [[ -n "$X_COORD" && -n "$LEN" && ( -z "$GENE_2" || -n "$Y_COORD" ) ]]; then
	fold_args=(-i "$OUT.hyb" -a "$GENE_1" -1 "$DB_1" -x "$X_COORD" -l "$LEN" -j "$VARNA" -r "$FOLD")
	if [[ -n "$Y_COORD" ]]; then fold_args+=(-y "$Y_COORD"); fi
	if [[ -n "$GENE_2" ]]; then fold_args+=(-b "$GENE_2" -2 "$DB_2"); fi
	hyb2_fold "${fold_args[@]}"
else
	echo "No Options Specified to Generate Secondary Structure." 1>&2
fi

echo "Analysis completed."
echo "To compare between different datasets and plot differential coverage map, similarity heatmap, and differential structures, use:"
echo "hyb2_compare -i <input.table> -a <GENE_ID> -d <FASTA>"
echo "For more details, run: hyb2_compare"
