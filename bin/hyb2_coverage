#!/bin/bash
set -eo pipefail
# Plot the contact map for a single gene or pair, optionally at selected coordinates.
usage() { echo "usage: hyb2_coverage -i input.hyb -a gene [-b gene] [-q quantile] [-w x1 -x x2 -y y1 -z y2] [-p protected-file ...]" >&2; exit 2; }
LIMIT=0.95
HYB= GENE_1= GENE_2= X1= X2= Y1= Y2=
protected=()
while getopts "i:a:b:q:w:x:y:z:p:" option; do
    case "$option" in
        i) HYB=$OPTARG ;;
        a) GENE_1=$OPTARG ;;
        b) GENE_2=$OPTARG ;;
        q) LIMIT=$OPTARG ;;
        w) X1=$OPTARG ;;
        x) X2=$OPTARG ;;
        y) Y1=$OPTARG ;;
        z) Y2=$OPTARG ;;
        p) protected+=(--protect="$OPTARG") ;;
        *) usage ;;
    esac
done
shift $((OPTIND-1))
[[ $# == 0 && -n "$HYB" && -n "$GENE_1" && "$GENE_1$GENE_2" != */* ]] || usage
[[ -f "$HYB" && -r "$HYB" ]] || { echo "Cannot read HYB: $HYB" >&2; exit 1; }

genes=$GENE_1
if [[ -n "$GENE_2" ]]; then genes=$GENE_1-$GENE_2; fi
contact=${HYB%.hyb}.$genes.contact.txt
base=${contact##*/}
stem=${base%.contact.txt}
bin_dir=$(cd -- "$(dirname -- "$0")" && pwd)
source "$bin_dir/cli_stage.sh"
hyb2_fix_path
work=$(mktemp -d "$(dirname -- "$contact")/.hyb2-coverage.XXXXXXXX")
trap hyb2_cleanup_stage EXIT
trap 'exit 1' HUP INT TERM
protected+=(--protect="$HYB")
outputs=()
if [[ -n "$X1$X2$Y1$Y2" ]]; then
    [[ -n "$X1" && -n "$X2" && -n "$Y1" && -n "$Y2" ]] || usage
    [[ -f "$contact" ]] || { echo "Cannot read contact table: $contact" >&2; exit 1; }
    cp -- "$contact" "$work/$base"
    protected+=(--protect="$contact")
    echo "Plotting zoomed-in contact density map of $genes ..."
    (cd -- "$work" && cdm_indiv_zoom.R "$base" "$X1" "$X2" "$Y1" "$Y2" "$LIMIT" "$GENE_1" "$GENE_2" "$stem")
    # R formats the integer coordinates in its output name (e.g. 01 -> 1).
    zoomed=("$work/$stem"_*.pdf)
    [[ ${#zoomed[@]} == 1 ]] || { echo "Expected one zoomed contact PDF" >&2; exit 1; }
    pdf=${zoomed[0]##*/}
    [[ ${pdf#"$stem"_} =~ ^-?[0-9]+--?[0-9]+_-?[0-9]+--?[0-9]+\.pdf$ ]] || { echo "Invalid zoomed contact PDF name: $pdf" >&2; exit 1; }
else
    echo "Plotting contact density map of $genes ..."
    # Put the requested first gene on the first arm for a two-gene map.
    if [[ -n "$GENE_2" ]]; then
        awk -v gene="$GENE_1" 'BEGIN {OFS="\t"} $4==gene {print} $10==gene {print $1,$2,$3,$10,$11,$12,$13,$14,$15,$4,$5,$6,$7,$8,$9}' < "$HYB"
    else
        cat -- "$HYB"
    fi | plot_hybrids_3.awk USE_ENTIRE_HYBRIDS=1 BIN_SIZE=10 "GENE_1=$GENE_1" "GENE_2=${GENE_2:-$GENE_1}" |
        awk 'NR==2 {print "x\ty\tcount"} {print}' > "$work/$base"
    if [[ -n "$GENE_2" ]]; then
        (cd -- "$work" && cdm_2genes.R "$base" "$LIMIT" "$GENE_1" "$GENE_2" "$stem")
    else
        (cd -- "$work" && contact_density_map_indiv.R "$base" "$LIMIT" "$stem")
    fi
    outputs+=("$work/$base" "$contact")
    pdf=$stem.pdf
fi
[[ -s "$work/$pdf" ]] || { echo "Renderer did not produce $pdf" >&2; exit 1; }
outputs+=("$work/$pdf" "$(dirname -- "$contact")/$pdf")
python3 "$bin_dir/sam2hyb_publish.py" --work="$work" "${protected[@]}" -- "${outputs[@]}"
echo "Contact Density Map of $genes Saved"
