#!/bin/bash
set -eo pipefail
# Plot the contact map for a single gene or pair, optionally at selected coordinates.
usage() { echo "usage: hyb2_coverage -i input.hyb -a gene [-b gene] [-q quantile] [-w x1 -x x2 -y y1 -z y2]" >&2; exit 2; }
LIMIT=0.95
while getopts "i:a:b:q:w:x:y:z:" option; do
    case "$option" in
        i) HYB=$OPTARG ;;
        a) GENE_1=$OPTARG ;;
        b) GENE_2=$OPTARG ;;
        q) LIMIT=$OPTARG ;;
        w) X1=$OPTARG ;;
        x) X2=$OPTARG ;;
        y) Y1=$OPTARG ;;
        z) Y2=$OPTARG ;;
        *) usage ;;
    esac
done
shift $((OPTIND-1))
[[ $# == 0 && -n "$HYB" && -n "$GENE_1" ]] || usage
[[ -f "$HYB" && -r "$HYB" ]] || { echo "Cannot read HYB: $HYB" >&2; exit 1; }

genes=$GENE_1
if [[ -n "$GENE_2" ]]; then genes=$GENE_1-$GENE_2; fi
contact=${HYB%.hyb}.$genes.contact.txt
if [[ -n "$X1$X2$Y1$Y2" ]]; then
    [[ -n "$X1" && -n "$X2" && -n "$Y1" && -n "$Y2" ]] || usage
    zoom=("$contact" "$X1" "$X2" "$Y1" "$Y2" "$LIMIT")
    if [[ -n "$GENE_2" ]]; then zoom+=("$GENE_1" "$GENE_2"); fi
    echo "Plotting zoomed-in contact density map of $genes ..."
    cdm_indiv_zoom.R "${zoom[@]}"
    echo "Zoomed-in Contact Density Map of $genes Saved"
    exit 0
fi

[[ ! -d "$contact" ]] || { echo "Contact map output is a directory: $contact" >&2; exit 1; }
staged=$(mktemp "${contact}.tmp.XXXXXX")
trap 'rm -f -- "$staged"' EXIT
trap 'exit 1' HUP INT TERM
echo "Plotting contact density map of $genes ..."
# Put the requested first gene on the first arm for a two-gene map.
if [[ -n "$GENE_2" ]]; then
    awk -v gene="$GENE_1" 'BEGIN {OFS="\t"} $4==gene {print} $10==gene {print $1,$2,$3,$10,$11,$12,$13,$14,$15,$4,$5,$6,$7,$8,$9}' < "$HYB"
else
    cat -- "$HYB"
fi | plot_hybrids_3.awk USE_ENTIRE_HYBRIDS=1 BIN_SIZE=10 "GENE_1=$GENE_1" "GENE_2=${GENE_2:-$GENE_1}" |
    awk 'NR==2 {print "x\ty\tcount"} {print}' > "$staged"
chmod =rw "$staged"
mv -f -- "$staged" "$contact"
if [[ -n "$GENE_2" ]]; then
    cdm_2genes.R "$contact" "$LIMIT" "$GENE_1" "$GENE_2"
else
    contact_density_map_indiv.R "$contact" "$LIMIT"
fi
echo "Contact Density Map of $genes Saved"
