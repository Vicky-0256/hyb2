#!/bin/bash
# Fold one window or two windows joined by the legacy 100-base linker.
set -eo pipefail
usage() { echo "usage: hyb2_fold -i input.hyb -a gene -d reference.fasta -x start -l length [-b gene -2 reference.fasta] [-y start] [-r 0|1|2] [-j jar] [-0 0|1]" >&2; exit 2; }
input= gene= other= ref= ref2= x= y= len= interactive=
fold=1
jar=$(VARNAcmd.sh 2>/dev/null) || jar=
while getopts "i:a:b:d:1:2:x:y:l:j:0:r:" opt; do
	case "$opt" in
		i) input=$OPTARG;; a) gene=$OPTARG;; b) other=$OPTARG;; d|1) ref=$OPTARG;; 2) ref2=$OPTARG;;
		x) x=$OPTARG;; y) y=$OPTARG;; l) len=$OPTARG;; j) jar=$OPTARG;; 0) interactive=$OPTARG;; r) fold=$OPTARG;; *) usage;;
	esac
done
shift $((OPTIND-1))
[[ $# == 0 && "$input" == *.hyb && -n "$gene" && -n "$ref" && "$x" =~ ^[0-9]+$ &&
   "$len" =~ ^[0-9]+$ && ( -z "$y" || "$y" =~ ^[0-9]+$ ) ]] || usage
x=$((10#$x)); len=$((10#$len))
[[ $x -gt 0 && $len -gt 0 ]] || usage
if [[ -n "$y" ]]; then y=$((10#$y)); [[ $y -gt 0 ]] || usage; fi
ref2=${ref2:-$ref}
case "$fold" in 0|1|2) ;; *) usage;; esac

xend=$((x+len-1))
span=$len
mode=single
stem=${gene}_$x-$xend
if [[ -n "$other" || -n "$y" ]]; then
	if [[ -z "$y" ]]; then [[ "$other" == "$gene" ]] || usage; y=$x; fi
	yend=$((y+len-1))
	span=$((2*len+100))
	if [[ -z "$other" ]]; then
		[[ $x -le $y ]] || { echo "Intramolecular folding requires X <= Y." >&2; exit 2; }
		mode=long; other=$gene; ref2=$ref; stem=${stem}_$y-$yend
	elif [[ "$other" == "$gene" && "$ref2" -ef "$ref" ]]; then
		mode=homodimer; stem=${stem}_homodimer
	else
		mode=two; stem=$gene-$x-${xend}_$other-$y-$yend
	fi
fi
prefix=${input%.hyb}
fasta=$stem.fasta
reads=${prefix}_$stem.hyb
base=${reads%.hyb}
constraints=$base.1-${span}_folding_constraints.txt
scores=$base.basepair_scores.txt
ct=$fasta.ct
dbn=$fasta.vienna
raw=${prefix}__${fasta}.VARNA_scores.txt
log_scores=${raw%_scores.txt}_log2scores.txt
names=${base}_names_scores.txt
plot=$prefix.${fasta}_plot.svg
fragment=${fasta%.fasta}_1-$span.fasta
results=("$ct" "$dbn" "$scores" "$constraints" "$constraints.accepted" "$log_scores" "$names" "$fragment")
if [[ -n "$jar" && "$interactive" != 1 ]]; then results+=("$plot"); fi
scratch=("$reads" "$fasta" "$fasta.aux" "$fasta.bps" "$constraints.shuf" "$raw")
for path in "${results[@]}" "${scratch[@]}"; do
	for source in "$input" "$ref" "$ref2"; do
		[[ ! "$source" -ef "$path" && ! -d "$path" ]] || { echo "Fold output conflicts with input: $path" >&2; exit 1; }
	done
done
# Reject unreadable inputs before clearing a previous run's results.
for path in "$input" "$ref" "$ref2"; do [[ -f "$path" && -r "$path" ]] || { echo "Cannot read input: $path" >&2; exit 1; }; done
work=$(mktemp -d "${TMPDIR:-/tmp}/hyb2-fold.XXXXXX")
cleanup() {
	local rc=$?
	rm -rf -- "$work"
	rm -f -- "${scratch[@]}"
	if [[ $rc != 0 ]]; then rm -f -- "${results[@]}"; fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
rm -f -- "${results[@]}" "${scratch[@]}"
case "$fold" in 0) unafold_check;; 2) mfold_check;; esac
second=
linker=
first=$(fasta_record.awk -v id="$gene" -v start="$x" -v count="$len" "$ref")
if [[ "$mode" != single ]]; then
	second=$(fasta_record.awk -v id="$other" -v start="$y" -v count="$len" "$ref2")
	linker=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAATTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT
fi
printf '>%s\n%s%s%s\n' "$gene" "$first" "$linker" "$second" > "$fasta"

# Use the input arm order for matching two independent references with the
# same identifier. All projected arms are coordinates on the joined FASTA.
awk -F '\t' -v mode="$mode" -v g="$gene" -v h="${other:-$gene}" -v x="$x" -v y="$y" -v len="$len" '
	BEGIN {OFS="\t"}
	function inside(id, a, b, want, start) {return ("@" id)==("@" want) && a+0>=start && b+0>=a+0 && b+0<start+len}
	function project(delta1,delta2) {print $1,$2,$3,g,$5,$6,$7+delta1,$8+delta1,$9,g,$11,$12,$13+delta2,$14+delta2,$15}
	mode=="single" {if (inside($4,$7,$8,g,x) && inside($10,$13,$14,g,x)) project(1-x,1-x); next}
	mode=="homodimer" && $16+0<5 {next}
	{
		forward=inside($4,$7,$8,g,x) && inside($10,$13,$14,h,y)
		reverse=inside($4,$7,$8,h,y) && inside($10,$13,$14,g,x)
		if (forward) project(1-x,len+101-y)
		if (reverse && (!forward || mode!="two")) project(len+101-y,1-x)
	}' "$input" > "$reads"
comradesMakeConstraints_2 -i "$reads" -f "$fasta" -b 1 -e "$span"
comradesFold2 -c "$constraints" -i "$fasta" -r "$fold"
if [[ "$fold" == 0 ]]; then rm -f -- "$fasta".*.plot "$fasta".*.ext "$fasta.run"; fi

# Score the structure produced by this run; unrelated and older CT files may
# exist for the same locus in the working directory.
echo "Calculating Basepair Scores..."
printf '%s\t0\t%s\t%s\n' "$ct" "$span" "$span" > "$work/coordinates"
bp_score.sh -c "$work/coordinates" -s "$scores" -p "$input"
score=$(awk -v n="$span" '{sum+=$1} END {if (NR!=n) exit 1; print sum+0}' "$raw")
printf '%s\t%s\n' "$raw" "$score" > "$names"
awk '{print log($1+1)/log(2)}' "$raw" > "$log_scores"
echo "Top scoring structures:"
cat -- "$names" "$dbn"
echo "Load $log_scores as colour coding score in VARNA"
if [[ -n "$jar" ]]; then
	args=(-i "$ct" -j "$jar" -s "$log_scores" -x "$x" -l "$len" -p "$prefix")
	if [[ -n "$y" ]]; then args+=(-y "$y"); fi
	if [[ "$interactive" == 1 ]]; then args+=(-0 1); fi
	plot_VARNA "${args[@]}"
	if [[ "$interactive" != 1 && ! -s "$plot" ]]; then echo "VARNA did not produce $plot." >&2; exit 1; fi
elif [[ "$interactive" == 1 ]]; then
	echo "Interactive plotting requires a configured VARNA jar or -j." >&2; exit 1
fi
echo "For additional folds: qsub comradesFold2 -c $constraints -i $fragment -s 1"
