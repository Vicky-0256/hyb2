#!/bin/bash
# Install hyb2: run from the repository (bin/hyb2_install_macOS-arm). Safe to rerun.
set -euo pipefail
cd -- "$(dirname -- "$0")/.."

# Step 1: Copy the conda environment file and record the VARNAcmd.jar path
# (bin/VARNAcmd.sh prints bin/VARNA.dir)
cp bin/environment_osx-arm.yml ./environment.yml
printf '%s\n' "$PWD/VARNA/build/jar/VARNAcmd.jar" > bin/VARNA.dir

# Step 2: Add hyb2 to PATH in the shell's configuration file (once)
add_line() {
    touch "$1"
    grep -qxF -- "$2" "$1" || printf '%s\n' "$2" >> "$1"
}
case "${SHELL:-}" in
    */zsh) rc=~/.zshrc ;;
    */bash) rc=~/.bashrc ;;
    *) rc= ;;
esac
if [[ -n "$rc" ]]; then
    add_line "$rc" 'export PATH=$PATH:'"$PWD/bin"
    add_line "$rc" 'alias Hyb2='"$PWD"
    echo "Added hyb2 to $rc; open a new terminal (or source $rc) to use it."
else
    echo "Unknown shell: ${SHELL:-unset}. Add $PWD/bin to PATH in your shell's configuration file."
fi
export PATH="$PATH:$PWD/bin"

# Step 3: Create (or update) and activate the hyb2_macOS-arm conda environment
echo "Creating hyb2 conda environments"
set +u  # conda's shell functions use unset variables
source "$(conda info --base)/etc/profile.d/conda.sh"
if conda env list | awk -v env='hyb2_macOS-arm' '$1 == env {found = 1} END {exit !found}'; then
    conda env update -n hyb2_macOS-arm -f bin/hyb2_macOS-arm.yml
else
    conda env create -f bin/hyb2_macOS-arm.yml
fi
conda activate hyb2_macOS-arm
set -u
# DESeq2 not supported in Mac osx-arm
# R -e "options(repos = c(CRAN = 'https://cloud.r-project.org')); install.packages('BiocManager')"
# R -e "BiocManager::install('DESeq2')"

# Step 5: Initialize renv (creates a new renv.lock file) on the first run
echo "Ignore warnings: package(s) were not installed successfully, reinstall before snapshotting the lockfile."
if [[ ! -d renv ]]; then Rscript -e 'renv::init()'; fi

# Step 6: Replace the new renv.lock with the one in hyb2/bin
cp bin/renv.lock_osx-arm ./renv.lock

# Step 7: Restore the R environment using renv
Rscript -e 'renv::restore()'

# Step 8: Add hyb2 to PATH in R
Rscript -e 'Sys.setenv(PATH=paste(Sys.getenv("PATH"), "'"$PWD/bin"'", sep=":"))'

cp -r renv ~/
cp bin/hyb2_shiny.R ~/
rm -f .Rprofile

echo "Hyb2 Installation Complete"
