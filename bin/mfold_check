#!/bin/bash
# mfold_check: does mfold (comradesFold2 -r 2) fold with forced base pairs?
# The same test as unafold_check: a 34-nt sequence with one forced helix the
# MFE does not contain.  Exit 0 when it works; otherwise say why on stderr
# and exit 1.  MFOLD names another mfold script.

DIR=$(mktemp -d "${TMPDIR:-/tmp}/mfold_check.XXXXXX") || exit 1
trap 'rm -rf "$DIR"' EXIT
printf ">t\nGGGGAAAACCCCAUUUUUUUUUUUAAAAAAAAAA\n" > "$DIR/t.fa"
printf "F\t14\t34\t3\n" > "$DIR/t.aux"

if ! mfold_fold "$DIR/t.fa" "$DIR/t.aux" "$DIR/t.ct" 2> "$DIR/err"; then
	echo "mfold mode (-r 2): mfold did not fold a test sequence. $(cat "$DIR/err")" 1>&2
	echo "Install it with: conda install -c bioconda mfold, or use ViennaRNA (-r 1)." 1>&2
	exit 1
fi
FORCED=$(awk 'NR > 1 && (($1 == 14 && $5 == 34) || ($1 == 15 && $5 == 33) || ($1 == 16 && $5 == 32)) {n++} END {print n + 0}' "$DIR/t.ct")
if [ "$FORCED" != "3" ]; then
	echo "mfold mode (-r 2): mfold ignored a forced base pair, so the chimera constraints would have no effect. Use ViennaRNA (-r 1)." 1>&2
	exit 1
fi
exit 0
