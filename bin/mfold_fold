#!/bin/bash
# mfold_fold: fold one sequence with mfold 3.6, applying forced and
# prohibited base pairs, and write its minimum free energy structure as a
# .ct file in hybrid-ss-min's layout (header "N<TAB>dG = E<TAB>name").
#
#   mfold_fold <in.fasta> <constraints.aux|-> <out.ct>
#
# Constraints are hybrid-ss-min / mfold lines: "F i j k" forces the helix
# i-j, i+1-j-1, ... (k pairs); "P i j k" prohibits pairs; tabs or spaces.
# mfold also accepts O for zero and "P i-j k-l" for a range prohibition.
# "-" folds without constraints.  Used by comradesFold2 -r 2.
#
# mfold writes many files named after the sequence, and the bioconda build
# finds its energy tables only in the current directory, so every fold runs
# in a fresh temporary directory with links to the tables (mfold_datdir).
# MFOLD names another mfold script (default: mfold on PATH).
#
# Publish the first complete structure on success. Exit 42 for an infeasible
# constraint set; execution or output errors fail with a different status.

set -eo pipefail
CHECK_CT=$(cd "$(dirname "$0")" && pwd -P)/comrades_ct.awk
if [[ ! -r "$CHECK_CT" ]]; then CHECK_CT=$(command -v comrades_ct.awk); fi
IN=$1
AUX=$2
OUT=$3
EXE=${MFOLD:-mfold}

if [ -z "$IN" ] || [ -z "$AUX" ] || [ -z "$OUT" ]; then
	echo "usage: mfold_fold <in.fasta> <constraints.aux|-> <out.ct>" 1>&2
	exit 1
fi
if [[ "$IN" -ef "$OUT" || ( "$AUX" != "-" && "$AUX" -ef "$OUT" ) ]]; then
	echo "mfold input and output paths must be different." >&2
	exit 1
fi
rm -f -- "$OUT"
if ! EXE=$(command -v "$EXE"); then
	echo "mfold was not found (conda install -c bioconda mfold)." 1>&2
	exit 1
fi
[[ "$EXE" = /* ]] || EXE="$PWD/$EXE"
export PATH="$(dirname "$EXE"):$PATH"
if ! DATDIR=$(mfold_datdir 2>/dev/null) || [ -z "$DATDIR" ] || ! ls "$DATDIR"/*.dat > /dev/null 2>&1; then
	echo "mfold's energy tables were not found (mfold_datdir: '$DATDIR')." 1>&2
	exit 1
fi
DATDIR=$(cd "$DATDIR" && pwd -P)

DIR=$(mktemp -d "${TMPDIR:-/tmp}/mfold_fold.XXXXXX") || exit 1
STAGED=
trap 'rm -rf -- "$DIR"; if [ -n "$STAGED" ]; then rm -f -- "$STAGED"; fi' EXIT
for table in "$DATDIR"/*.dat; do
	ln -s "$table" "$DIR/"
done
# Keep the first FASTA record for validation. mfold consumes its own copy;
# its Fortran reader accepts sequence lines wrapped at 60 bases.
awk '{sub(/\r$/, "")}
	/^>/ {if (seen++) exit; print; next}
	seen {gsub(/[[:space:]]/, ""); bases += length($0)
	      for (i = 1; i <= length($0); i += 60) print substr($0, i, 60)}
	END {if (!bases) exit 1}' "$IN" > "$DIR/input.fa" || { echo "No input sequence for mfold." >&2; exit 1; }
cp "$DIR/input.fa" "$DIR/s.seq"
ARGS=(SEQ=s.seq NA=RNA MAX=1)
if [ "$AUX" != "-" ]; then
	tr '\t' ' ' < "$AUX" > "$DIR/s.aux"
	ARGS+=(AUX=s.aux)
fi
status=0
( cd "$DIR" && "$EXE" "${ARGS[@]}" > mfold.out 2>&1 ) || status=$?
if [ "$status" -ne 0 ] || [ ! -s "$DIR/s.ct" ]; then
	# mfold 3.6 explicitly reports an empty solution set for incompatible
	# stems. A missing CT or a different failure on its own is a tool error.
	if [ -s "$DIR/s.aux" ] && [ ! -s "$DIR/s.ct" ] && [ "$status" -le 1 ] &&
	   grep -Eiq '^[[:space:]]*Save file is empty[.] No foldings?[.]?[[:space:]]*$' "$DIR/mfold.out"; then
		echo "mfold found no structure for these constraints." >&2
		exit 42
	fi
	if [ "$status" -ne 0 ]; then
		echo "mfold failed with exit status $status." >&2
	else
		echo "mfold finished without a CT structure." >&2
	fi
	tail -n 2 "$DIR/mfold.out" >&2
	exit 1
fi
# Validate and stage beside the output so the final rename is atomic.
STAGED=$(mktemp "${OUT}.tmp.XXXXXX")
constraints=
if [ "$AUX" != "-" ]; then constraints=$DIR/s.aux; fi
LC_ALL=C awk -v normalize=1 -v constraints="$constraints" -f "$CHECK_CT" "$DIR/input.fa" "$DIR/s.ct" > "$STAGED"
# Match normal redirection permissions under the caller's umask.
chmod =rw "$STAGED"
mv -f -- "$STAGED" "$OUT"
