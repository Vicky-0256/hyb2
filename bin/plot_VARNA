#!/bin/bash
# Render the selected CT with its per-nucleotide scores.
set -eo pipefail
ct= scores= x= y= length= interactive= prefix=
jar=$(VARNAcmd.sh 2>/dev/null) || jar=
while getopts "i:s:j:x:y:l:0:p:" opt; do
	case "$opt" in i) ct=$OPTARG;; s) scores=$OPTARG;; j) jar=$OPTARG;; x) x=$OPTARG;;
		y) y=$OPTARG;; l) length=$OPTARG;; 0) interactive=$OPTARG;; p) prefix=$OPTARG;; *) exit 2;; esac
done
[[ -s "$ct" && -s "$scores" && -n "$jar" ]] || { echo "VARNA requires a CT, scores and a jar." >&2; exit 1; }
title=$(awk 'FNR==1 {print $5}' "$ct")
colors=$(paste -sd , "$scores")
max=$(awk 'NR==1 || $1>m {m=$1} END {print m+0}' "$scores")
style=$(awk -v m="$max" 'BEGIN{print "0.00:#FFFFFF," m*0.2 ":#4747FF," m*0.55 ":#1CFF47," m*0.65 ":#FFFF47," m*0.9 ":#FF4747," m ":#B64747"}')
java=java
if [[ $(uname -a) == *WSL* ]]; then
	shopt -s nullglob
	versions=(/mnt/c/Program\ Files/Java/*/bin/java.exe)
	[[ ${#versions[@]} -gt 0 ]] || { echo "Windows Java executable not found." >&2; exit 1; }
	java=$(printf '%s\n' "${versions[@]}" | sort -V | tail -n 1)
fi
args=(-jar "$jar" -i "$ct" -bpStyle simple -colorMap "$colors" -colorMapMin 0 -colorMapMax "$max" -colorMapStyle "$style" -title "$title" -spaceBetweenBases 0.6)
if [[ "$interactive" == 1 ]]; then "$java" "${args[@]}"; exit; fi
svg=${ct%.ct}.svg
prefix=${prefix:-${scores%%__*}}
name=${svg##*/}; plot=$prefix.${name%.svg}_plot.svg
rm -f -- "$svg" "$plot"
cleanup() { local rc=$?; rm -f -- "$svg"; if [[ $rc != 0 ]]; then rm -f -- "$plot"; fi; }
trap cleanup EXIT
"$java" "${args[@]}" -o "$svg"
[[ -s "$svg" ]] || { echo "VARNA did not write $svg" >&2; exit 1; }
coords=(-i "$svg" -x "$x" -l "$length" -p "$prefix")
if [[ -n "$y" ]]; then coords+=(-y "$y"); fi
svg_mod_coord.sh "${coords[@]}"
[[ -s "$plot" ]] || { echo "Coordinate adjustment did not write $plot" >&2; exit 1; }
