#!/bin/bash
set -eo pipefail
usage() { echo "usage: plot_viewpoint -i input.hyb -d reference.fasta -a gene [-2 reference.fasta -b gene]" >&2; exit 2; }
hyb= ref= ref2= gene= other=
while getopts "i:d:1:2:a:b:" opt; do
	case "$opt" in i) hyb=$OPTARG;; d|1) ref=$OPTARG;; 2) ref2=$OPTARG;; a) gene=$OPTARG;; b) other=$OPTARG;; *) usage;; esac
done
shift $((OPTIND-1))
[[ $# == 0 && "$hyb" == *.hyb && -n "$ref" && -n "$gene" ]] || usage
ref2=${ref2:-$ref}
prefix=${hyb%.hyb}
single=${prefix}_$gene
homo=${prefix}_${gene}_homodimers
cross=${prefix}_${gene}_$other
first=${prefix}_${other}_$gene
second=$cross
if [[ "$gene" == "$other" && ! "$ref" -ef "$ref2" ]]; then first=${first}_ref1; second=${second}_ref2; fi

work=$(mktemp -d "${TMPDIR:-/tmp}/hyb2-viewpoint.XXXXXX")
plots=("$single" "${prefix}_homodimers_$gene")
if [[ -n "$other" ]]; then plots+=("$first" "$second"); fi
outputs=("$single.blast" "$homo.blast")
for stem in "${plots[@]}"; do outputs+=("$stem.gplot" "${stem}_viewpoint.pdf"); done
for path in "${outputs[@]}"; do
	[[ ! "$path" -ef "$hyb" && ! "$path" -ef "$ref" && ! "$path" -ef "$ref2" && ! -d "$path" ]] || { echo "Output conflicts with input: $path" >&2; exit 1; }
done
cleanup() {
	local rc=$?
	rm -rf -- "$work"
	if [[ $rc != 0 ]]; then rm -f -- "${outputs[@]}"; fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
rm -f -- "${outputs[@]}"
for path in "$hyb" "$ref" "$ref2"; do [[ -f "$path" && -r "$path" ]] || { echo "Cannot read viewpoint input: $path" >&2; exit 1; }; done
len=$(fasta_record.awk -v id="$gene" -v length_only=1 "$ref")
if [[ -n "$other" ]]; then len2=$(fasta_record.awk -v id="$other" -v length_only=1 "$ref2"); fi

select_arms() {
	awk -F '\t' -v a="@$2" -v b="@$3" '(("@" $4)==a && ("@" $10)==b) || (("@" $4)==b && ("@" $10)==a)' "$1" | hyb2blast.awk
}
draw() {
	local blast=$1 id=$2 length=$3 stem=$4 role=${5:-0}
	# The legacy BLAST exporter emits the two arms in HYB order and keeps
	# increasing intervals. Range differences avoid iterating over each hit.
	awk -F '\t' -v id="@$id" -v n="$length" -v label="$stem" -v role="$role" '
		("@" $2)==id && (!role || (NR%2 ? 1 : 2)==role) && $10+0>$9+0 {
			start=($9<1 ? 1 : $9); stop=($10>n ? n : $10)
			if (start<=stop) {delta[start]++; delta[stop+1]--}
		}
		END {print "#" label "_" n; for(i=1;i<=n;i++){total+=delta[i]; print i "\t" total}}' "$blast" > "$work/coverage"
	mv -- "$work/coverage" "$stem.gplot"
	viewpoint_graph.R "$stem.gplot"
	[[ -s "${stem}_viewpoint.pdf" ]] || { echo "Viewpoint renderer did not produce ${stem}_viewpoint.pdf" >&2; exit 1; }
}
select_arms "$hyb" "$gene" "$gene" > "$single.blast"
draw "$single.blast" "$gene" "$len" "$single"
if [[ -s "${prefix}_homodimers.hyb" ]]; then
	select_arms "${prefix}_homodimers.hyb" "$gene" "$gene" > "$homo.blast"
	draw "$homo.blast" "$gene" "$len" "${prefix}_homodimers_$gene"
fi
if [[ -n "$other" ]]; then
	select_arms "$hyb" "$gene" "$other" > "$work/cross.blast"
	if [[ "$gene" == "$other" && ! "$ref" -ef "$ref2" ]]; then
		draw "$work/cross.blast" "$gene" "$len" "$first" 1
		draw "$work/cross.blast" "$other" "$len2" "$second" 2
	else
		draw "$work/cross.blast" "$gene" "$len" "$first"
		if [[ "$first" != "$second" ]]; then draw "$work/cross.blast" "$other" "$len2" "$second"; fi
	fi
fi
