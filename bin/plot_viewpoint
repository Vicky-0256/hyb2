#!/bin/bash
set -eo pipefail
usage() { echo "usage: plot_viewpoint -i input.hyb -d reference.fasta -a gene [-2 reference.fasta -b gene] [-p protected-file ...]" >&2; exit 2; }
hyb= ref= ref2= gene= other=
protected=()
while getopts "i:d:1:2:a:b:p:" opt; do
	case "$opt" in i) hyb=$OPTARG;; d|1) ref=$OPTARG;; 2) ref2=$OPTARG;; a) gene=$OPTARG;; b) other=$OPTARG;; p) protected+=(--protect="$OPTARG");; *) usage;; esac
done
shift $((OPTIND-1))
[[ $# == 0 && "$hyb" == *.hyb && -n "$ref" && -n "$gene" && "$gene$other" != */* ]] || usage
ref2=${ref2:-$ref}
prefix=${hyb%.hyb}
single=${prefix}_$gene
homo=${prefix}_${gene}_homodimers
cross=${prefix}_${gene}_$other
first=${prefix}_${other}_$gene
second=$cross
if [[ "$gene" == "$other" && ! "$ref" -ef "$ref2" ]]; then first=${first}_ref1; second=${second}_ref2; fi

for path in "$hyb" "$ref" "$ref2"; do [[ -f "$path" && -r "$path" ]] || { echo "Cannot read viewpoint input: $path" >&2; exit 1; }; done
protected+=(--protect="$hyb" --protect="$ref" --protect="$ref2" --protect="${prefix}_homodimers.hyb")
bin_dir=$(cd -- "$(dirname -- "$0")" && pwd)
source "$bin_dir/cli_stage.sh"
hyb2_fix_path
work=$(mktemp -d "$(dirname -- "$hyb")/.hyb2-viewpoint.XXXXXXXX")
trap hyb2_cleanup_stage EXIT
trap 'exit 1' HUP INT TERM
outputs=()
len=$(fasta_record.awk -v id="$gene" -v length_only=1 < "$ref")
if [[ -n "$other" ]]; then len2=$(fasta_record.awk -v id="$other" -v length_only=1 < "$ref2"); fi

select_arms() {
	awk -F '\t' -v a="@$2" -v b="@$3" '(("@" $4)==a && ("@" $10)==b) || (("@" $4)==b && ("@" $10)==a)' < "$1" | hyb2blast.awk
}
draw() {
	local blast=$1 id=$2 length=$3 stem=$4 role=${5:-0}
	local slot=$work/draw-${#outputs[@]} base=${4##*/}
	mkdir -- "$slot"
	# The legacy BLAST exporter emits the two arms in HYB order and keeps
	# increasing intervals. Range differences avoid iterating over each hit.
	awk -F '\t' -v id="@$id" -v n="$length" -v label="$stem" -v role="$role" '
		("@" $2)==id && (!role || (NR%2 ? 1 : 2)==role) && $10+0>$9+0 {
			start=($9<1 ? 1 : $9); stop=($10>n ? n : $10)
			if (start<=stop) {delta[start]++; delta[stop+1]--}
		}
		END {print "#" label "_" n; for(i=1;i<=n;i++){total+=delta[i]; print i "\t" total}}' < "$blast" > "$slot/$base.gplot"
	(cd -- "$slot" && viewpoint_graph.R "$base.gplot")
	[[ -s "$slot/${base}_viewpoint.pdf" ]] || { echo "Viewpoint renderer did not produce ${stem}_viewpoint.pdf" >&2; exit 1; }
	outputs+=("$slot/$base.gplot" "$stem.gplot" "$slot/${base}_viewpoint.pdf" "${stem}_viewpoint.pdf")
}
select_arms "$hyb" "$gene" "$gene" > "$work/single.blast"
outputs+=("$work/single.blast" "$single.blast")
draw "$work/single.blast" "$gene" "$len" "$single"
if [[ -s "${prefix}_homodimers.hyb" ]]; then
	select_arms "${prefix}_homodimers.hyb" "$gene" "$gene" > "$work/homo.blast"
	outputs+=("$work/homo.blast" "$homo.blast")
	draw "$work/homo.blast" "$gene" "$len" "${prefix}_homodimers_$gene"
fi
if [[ -n "$other" ]]; then
	select_arms "$hyb" "$gene" "$other" > "$work/cross.blast"
	if [[ "$gene" == "$other" && ! "$ref" -ef "$ref2" ]]; then
		draw "$work/cross.blast" "$gene" "$len" "$first" 1
		draw "$work/cross.blast" "$other" "$len2" "$second" 2
	else
		draw "$work/cross.blast" "$gene" "$len" "$first"
		if [[ "$first" != "$second" ]]; then draw "$work/cross.blast" "$other" "$len2" "$second"; fi
	fi
fi
python3 "$bin_dir/sam2hyb_publish.py" --work="$work" "${protected[@]}" -- "${outputs[@]}"
