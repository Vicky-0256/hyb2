#!/bin/bash
# Convert a SAM file with AS and NM tags to HYB. With -e 1 the legacy
# energy engine is ViennaRNA RNAcofold for all structure modes (-r).
set -eo pipefail

hval=0.1
gmax=4
hmax=10
ENERGY=1
while getopts "i:d:o:v:g:h:r:e:" option; do
    case "$option" in
        i) SAM=$OPTARG ;;
        d) DB=$OPTARG ;;
        o) OUT=$OPTARG ;;
        v) hval=$OPTARG ;;
        g) gmax=$OPTARG ;;
        h) hmax=$OPTARG ;;
        r) : ;;  # compatibility with the structure-folding option
        e) ENERGY=$OPTARG ;;
        *) exit 2 ;;
    esac
done
shift $((OPTIND - 1))
if [[ $# != 0 || ! -f "${SAM:-}" || -z "${OUT:-}" || ! "$ENERGY" =~ ^[01]$ ]]; then
    echo "Usage: sam2hyb -i reads.sam -o output-prefix [-d reference.fasta] [-e 0|1]" >&2
    exit 2
fi
if [[ "$ENERGY" == 1 && ! -f "${DB:-}" ]]; then
    echo "sam2hyb: -e 1 requires a readable reference FASTA (-d): ${DB:-missing}" >&2
    exit 2
fi

# Some legacy helpers derive filenames with shell substitutions. Give them
# local basenames even when the user's paths contain spaces or '.hyb'.
case "$SAM" in /*) ;; *) SAM="$PWD/$SAM" ;; esac
case "${DB:-}" in /*|"") ;; *) DB="$PWD/$DB" ;; esac
case "$OUT" in /*) ;; *) OUT="$PWD/$OUT" ;; esac
bin_dir=$(cd -- "$(dirname -- "$0")" && pwd)
export PATH="$PATH:$bin_dir"
work=$(mktemp -d "$(dirname -- "$OUT")/.sam2hyb.XXXXXXXX")
cleanup() {
    if [[ -e "$work/.publishing" ]]; then
        echo "sam2hyb: interrupted publication; recover staged files and originals in $work" >&2
    else
        rm -rf -- "$work"
    fi
}
trap cleanup EXIT
cd -- "$work"
ln -s -- "$SAM" input.sam

echo "Processing SAM file..."
sam2blast_3 input.sam > read.blast
collapse_blast_2.sh read.blast > read.collapse.blast
mtophits_blast read.collapse.blast > read_mtophits.blast
create_reference_file.pl read_mtophits.blast > read_mtophits.ref
remove_duplicate_hits_blast.pl read_mtophits.ref read_mtophits.blast | rm_blast_dup > read_singleE.blast
blast_stats_2 read_singleE.blast > read_singleE.blast_stats.txt
get_mtop_hybrids.pl BLAST_THRESHOLD="$hval" MODE=2 MAX_OVERLAP="$gmax" MAX_HITS_PER_SEQUENCE="$hmax" OUTPUT_FORMAT=HYB read.blast > read_hits.txt
getseqs_sam read_hits.txt input.sam > read_hybrids.fasta
txt2hyb.awk read_hybrids.fasta read_hits.txt > read_hybrids.hyb
remove_duplicate_hybrids_hOH5_2.pl PREFER_MIM=1 read_mtophits.ref read_hybrids.hyb > read_ua.hyb

hybrids=read_ua.hyb
if [[ "$ENERGY" == 1 ]]; then
    awk -f "$bin_dir/sam2hyb_cofold.awk" "$DB" "$hybrids" > pairs.fa
    if [[ -s pairs.fa ]]; then
        RNAcofold --noconv --noPS < pairs.fa > cofold.vienna || {
            rc=$?
            echo "sam2hyb: RNAcofold exited with status $rc" >&2
            exit "$rc"
        }
    else
        : > cofold.vienna
    fi
    add_dG_hyb_2.pl "$hybrids" cofold.vienna pairs.fa > read_dg.hyb
    hybrids=read_dg.hyb
fi
collapse_hyb_2.sh "$hybrids" | filter_homopolymers.awk | hyb_mapped_position_overlaps_3.awk | hyb_chim_types.awk > result.hyb
awk '$16>=5' result.hyb > homodimers.hyb
hybrid_stats_2 result.hyb > stats.txt

python "$bin_dir/sam2hyb_publish.py" "$OUT" "$SAM" "${DB:-}"
echo "Converted to hyb format."
