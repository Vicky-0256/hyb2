{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicky-0256.github.io/hyb2/schema/provenance.schema.json",
  "title": "HYB2 provenance (hyb2-result/1.0)",
  "type": "object",
  "required": [
    "schema",
    "run",
    "application",
    "generatedAt",
    "environment",
    "scope",
    "inputs",
    "steps",
    "methods",
    "reproducibility"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "hyb2-result/1.0"
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^run-[0-9a-f]{16}$"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "application": {
      "type": "object"
    },
    "generatedAt": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "fileName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^I[0-9]{2}$"
          },
          "role": {
            "type": "string"
          },
          "fileName": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256Status": {
            "enum": [
              "computed",
              "pending",
              "unavailable",
              "not_computed"
            ]
          },
          "records": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "key",
          "title",
          "status",
          "detail",
          "scope",
          "completedAt",
          "parameters",
          "inputs",
          "results",
          "tables",
          "figures"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "no_result",
              "not_run",
              "running",
              "failed",
              "stale",
              "pending"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^I[0-9]{2}$"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R[0-9]{2}$"
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T[0-9]{2}$"
            }
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F[0-9]{2}$"
            }
          }
        }
      }
    },
    "methods": {
      "type": "object"
    },
    "reproducibility": {
      "type": "string"
    }
  }
}
