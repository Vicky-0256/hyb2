{
  "name": "hyb2-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Tauri desktop shell for HYB2",
  "scripts": {
    "stage": "node scripts/stage-frontend.cjs",
    "dev:frontend": "npm run stage && python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "dev": "tauri dev",
    "build": "tauri build --bundles app",
    "build:installers": "npm run verify:release && tauri build",
    "check": "tauri info",
    "verify:release": "python3 scripts/verify-native-release.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
