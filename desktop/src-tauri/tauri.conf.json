{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HYB2 Desktop",
  "version": "0.1.0",
  "identifier": "org.cplfold.hyb2.desktop",
  "build": {
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "npm run dev:frontend",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run stage"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HYB2 Desktop",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Local RNA interaction analysis with HYB2",
    "longDescription": "HYB2 Desktop is an independent offline application for local RNA interaction analysis.",
    "resources": {
      "../resources/native/": "native/"
    }
  }
}
