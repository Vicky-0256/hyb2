# Pyodide toolchain pins, sourced by scripts/build-vienna-pyodide.sh and
# scripts/build-cplfold-web.sh.  The CI toolchain cache key hashes this file
# and scripts/pyodide-build-requirements.txt (plus the exact Python version),
# so only a change of pins discards the cached venv and cross-build
# environment.  Plain KEY=value lines only.
PYODIDE_VERSION=0.29.4
# the Emscripten that Pyodide's cross-build environment uses (checked against
# `pyodide config get emscripten_version` and emcc)
PYODIDE_EMSCRIPTEN_VERSION=4.0.9
